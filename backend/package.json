  "description": "API REST de autenticación y autorización con JWT para una clínica veterinaria (usuarios, roles y mascotas).",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-test-module-mocks --test",
    "demo": "node --experimental-test-module-mocks scripts/demo-server.mjs"
  },
  "keywords": [
    "jwt",
    "express",
    "postgresql",
    "rest-api",
    "auth"
