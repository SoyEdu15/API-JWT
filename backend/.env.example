PORT=3000

# Cadena de conexion a PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/api_jwt_db

# Claves secretas para firmar los JWT (cadenas aleatorias de al menos 16
# caracteres, distintas entre si). Genera una con: openssl rand -hex 32
JWT_SECRET=cambia_esta_clave_super_secreta
JWT_REFRESH_SECRET=cambia_esta_clave_de_refresh_tambien

# Origen permitido para peticiones CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173
